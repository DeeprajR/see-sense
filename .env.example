# Copy to .env and fill in. .env is read at startup; never commit or share it.
# Claude (required): sees the camera picture and plans the route. The workspace ID is only
# needed when the key isn't scoped to a workspace (Console -> Settings -> Workspaces).
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
# JEV (optional): checks what the mic heard before Claude, and picks which things need an alert.
TYPESAFE_API_KEY=
# Natural English voice (optional; recordings are cached on the device)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
